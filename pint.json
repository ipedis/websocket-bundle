{
  "preset": "symfony",
  "exclude": [
    "var"
  ],
    "rules": {
        "concat_space": {
            "spacing": "one"
        },
      "declare_strict_types": true,
      "php_unit_attributes": true,
      "php_unit_test_annotation": {
        "style": "annotation"
      },
      "php_unit_method_casing": {
        "case": "snake_case"
      },
      "fully_qualified_strict_types": {
        "import_symbols": true
      }
    }
}
